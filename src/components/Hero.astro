---
import { Image } from "astro:assets";
import miguel from "../assets/miguel.webp";
import { personal, languages } from "../data/profile";

const english = languages.find((lang) => lang.name === "Inglés");
// "Bello, Antioquia" en vez de la ubicación completa, para que la línea del rol quepa en una sola línea
const city = personal.location.split(", ").slice(0, 2).join(", ");
---

<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal">
        <span class="dot" aria-hidden="true"></span>
        {personal.available ? "disponible para nuevos proyectos" : "ocupado actualmente"}
      </p>

      <h1 class="hero-name reveal">{personal.name}</h1>
      <p class="hero-role mono reveal">
        {personal.role} ·{" "}
        {english?.certificateUrl ? (
          <a class="hero-english" href={english.certificateUrl} target="_blank" rel="noopener noreferrer" title="Ver certificado de inglés">
            Inglés B2
          </a>
        ) : (
          "Inglés B2"
        )}{" "}
        · {city}
      </p>

      <p class="hero-summary reveal">{personal.summary}</p>

      <div class="hero-cta reveal">
        <a class="btn btn-primary" href="#proyectos">Ver proyectos</a>
        <a class="btn btn-ghost" href="#contacto">Contactar</a>
      </div>
    </div>

    <div class="hero-photo reveal">
      <div class="photo-glow" aria-hidden="true"></div>
      <Image
        src={miguel}
        alt={personal.name}
        width={760}
        height={1013}
        class="photo"
        priority
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(64px + clamp(2.5rem, 7vw, 5rem));
    padding-bottom: var(--space-section);
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
  }

  .eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 0 3px rgba(94, 234, 212, 0.15);
  }

  .hero-name {
    margin-top: 0.9rem;
    font-size: var(--fs-3xl);
  }

  .hero-role {
    margin-top: 0.85rem;
    color: var(--accent);
    font-size: var(--fs-sm);
  }

  .hero-english {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s var(--ease-out);
  }

  .hero-english:hover {
    text-decoration-color: var(--accent);
  }

  .hero-summary {
    margin-top: 1.4rem;
    max-width: 46ch;
    color: var(--ink-muted);
    font-size: var(--fs-base);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.2rem;
    margin-bottom: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    transition: transform 0.2s var(--ease-out), border-color 0.2s var(--ease-out), background 0.2s var(--ease-out);
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
  }

  .btn-ghost {
    border-color: var(--line);
    color: var(--ink);
  }

  .btn-ghost:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  /* Foto: sin marco ni chrome de ventana, flota directamente sobre el fondo */
  .hero-photo {
    position: relative;
    justify-self: center;
    width: 100%;
  }

  .photo-glow {
    position: absolute;
    inset: -10% -20% -4%;
    background:
      radial-gradient(closest-side, rgba(255, 180, 84, 0.16), transparent 70%),
      radial-gradient(closest-side, rgba(94, 234, 212, 0.12), transparent 75%);
    background-position: 30% 20%, 80% 90%;
    background-repeat: no-repeat;
    background-size: 75% 75%, 65% 65%;
    filter: blur(30px);
    z-index: 0;
  }

  .photo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    max-height: min(56vh, 620px);
    object-fit: contain;
    object-position: bottom;
    filter: drop-shadow(0 25px 40px rgba(0, 0, 0, 0.55));
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 97%);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 97%);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      align-items: center;
    }

    .hero-photo {
      order: -1;
      max-width: 300px;
      margin-inline: auto;
    }

    .photo {
      max-height: 46vh;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: calc(64px + 1.75rem);
    }

    .hero-name {
      font-size: 2.35rem;
    }

    .hero-photo {
      max-width: 220px;
    }

    .photo {
      max-height: 36vh;
    }

    .hero-cta {
      margin-top: 1.7rem;
    }

    .btn {
      flex: 1;
      justify-content: center;
      padding: 0.85rem 1rem;
    }
  }
</style>
