---
import { getLang, getProfile, homePath, langs, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { nav, personal } = getProfile(lang);
const otherLang = langs.find((l) => l !== lang) ?? "es";
---

<header class="nav-root">
  <div class="wrap nav-bar">
    <a href="#top" class="logo mono" aria-label={t("nav.home")}>
      <span class="logo-prompt">~</span>/miguel<span class="logo-caret">_</span>
    </a>

    <nav class="links mono" aria-label={t("nav.sections")}>
      {
        nav.map((item) => (
          <a href={item.href}>
            <span class="slash">/</span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="status mono" aria-hidden="true">
      <span class="dot" class:list={{ off: !personal.available }}></span>
      {personal.available ? t("status.available") : t("status.unavailable")}
    </div>

    <a
      class="lang-switch mono"
      href={homePath[otherLang]}
      hreflang={otherLang}
      aria-label={t("lang.switchLabel")}
      data-lang-switch
    >
      {langs.map((l) => (
        <span class:list={["lang-opt", { "is-current": l === lang }]} aria-hidden="true">{l.toUpperCase()}</span>
      ))}
    </a>

    <a class="cv-btn mono" href={personal.cvUrl} download>
      <span class="arrow">↓</span> {t("nav.downloadCv")}
    </a>

    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label={t("nav.openMenu")}>
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu mono" aria-label={t("nav.mobile")}>
    {
      nav.map((item) => (
        <a href={item.href}>
          <span class="slash">/</span>
          {item.label}
        </a>
      ))
    }
    <a class="mobile-cv-btn" href={personal.cvUrl} download>
      <span class="arrow">↓</span> {t("nav.downloadCv")}
    </a>
    <div class="mobile-status">
      <span class="dot" class:list={{ off: !personal.available }}></span>
      {personal.available ? t("status.availableWork") : t("status.unavailable")}
    </div>
  </nav>
</header>

<!-- Fuera del header: su backdrop-filter haría que `position: fixed` se anclara al header y no a la pantalla -->
<a class="fab-cv-btn mono" href={personal.cvUrl} download aria-label={t("nav.downloadCv")}>
  <span class="arrow">↓</span> {t("nav.downloadCv")}
</a>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open");
    btn.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  // Al cambiar de idioma se conserva la sección en la que estaba el usuario
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((link) =>
    link.addEventListener("click", () => {
      if (location.hash) link.hash = location.hash;
    })
  );

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.remove("is-open");
      btn?.setAttribute("aria-expanded", "false");
    })
  );
</script>

<style>
  .nav-root {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgba(10, 14, 23, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
  }

  .logo {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .logo-prompt {
    color: var(--accent-2);
  }

  .logo-caret {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin-left: 1rem;
    flex: 1;
  }

  .links a {
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    white-space: nowrap;
    transition: color 0.2s var(--ease-out);
  }

  .links a:hover {
    color: var(--ink);
  }

  .slash {
    color: var(--ink-faint);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-2xs);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 0 3px rgba(94, 234, 212, 0.15);
  }

  .dot.off {
    background: var(--ink-faint);
    box-shadow: none;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--fs-2xs);
    font-weight: 500;
    transition: border-color 0.2s var(--ease-out);
  }

  .lang-switch:hover {
    border-color: var(--accent);
  }

  .lang-opt {
    padding: 0.3rem 0.5rem;
    border-radius: calc(var(--radius-sm) - 2px);
    color: var(--ink-muted);
    transition: color 0.2s var(--ease-out);
  }

  .lang-switch:hover .lang-opt:not(.is-current) {
    color: var(--ink);
  }

  .lang-opt.is-current {
    background: var(--accent);
    color: var(--bg);
  }

  .cv-btn,
  .mobile-cv-btn,
  .fab-cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.85rem;
    white-space: nowrap;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .cv-btn:hover,
  .mobile-cv-btn:hover,
  .fab-cv-btn:hover {
    border-color: var(--accent);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .cv-btn:active,
  .mobile-cv-btn:active,
  .fab-cv-btn:active {
    border-color: var(--accent);
    color: var(--ink);
    transform: scale(0.96);
  }

  .cv-btn .arrow,
  .mobile-cv-btn .arrow,
  .fab-cv-btn .arrow {
    color: var(--accent);
  }

  .mobile-cv-btn,
  .fab-cv-btn {
    display: none;
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .menu-btn span {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out), opacity 0.25s var(--ease-out);
  }

  .mobile-menu {
    display: none;
  }

  /* Con el selector de idioma ya no cabe todo: el estado se repite en el hero */
  @media (max-width: 1440px) {
    .status {
      display: none;
    }

    .links {
      gap: 1.1rem;
    }
  }

  @media (max-width: 1200px) {
    .links,
    .status,
    .cv-btn {
      display: none;
    }

    .menu-btn {
      display: flex;
    }

    .lang-switch {
      margin-left: auto;
    }

    .mobile-menu {
      display: flex;
      flex-direction: column;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      border-top: 1px solid transparent;
      transition: max-height 0.3s var(--ease-out);
    }

    .mobile-menu.is-open {
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      border-top-color: var(--line);
    }

    .mobile-menu a {
      padding: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
      font-size: var(--fs-sm);
      color: var(--ink-muted);
      border-bottom: 1px solid var(--line);
    }

    .mobile-cv-btn {
      display: inline-flex;
      justify-content: center;
      margin: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
    }

    .mobile-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
      font-size: var(--fs-2xs);
      color: var(--ink-muted);
    }

    .fab-cv-btn {
      display: inline-flex;
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 60;
      background: rgba(10, 14, 23, 0.85);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
  }
</style>
