---
import { getLang, getProfile, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { education, languages } = getProfile(lang);
---

<section id="educacion" class="edu-section">
  <div class="wrap">
    <p class="eyebrow reveal">{t("edu.eyebrow")}</p>
    <h2 class="section-heading reveal">{t("edu.heading")}</h2>

    <div class="edu-columns">
      <div class="edu-col">
        <p class="col-label mono reveal">{t("edu.training")}</p>
        <div class="card-list">
          {
            education.map((item, i) => (
              <div class="edu-card reveal" style={`transition-delay:${i * 80}ms`}>
                <div class="edu-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 4 2 9l10 5 10-5-10-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M6 11v4.5c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M22 9v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </div>
                <div class="edu-body">
                  <p class="edu-title">{item.title}</p>
                  <p class="edu-institution mono">{item.institution}</p>
                  <p class="edu-period mono">{item.period}</p>
                  {item.certificateUrl && (
                    <a class="cert-btn mono" href={item.certificateUrl} download>
                      <span class="arrow">↓</span> {item.certificateLabel}
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="edu-col">
        <p class="col-label mono reveal">{t("edu.languages")}</p>
        <div class="card-list">
          {
            languages.map((lang, i) => (
              <div class="edu-card reveal" style={`transition-delay:${(i + education.length) * 80}ms`}>
                <div class="edu-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                    <path d="M3 12h18" stroke="currentColor" stroke-width="1.6" />
                    <path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </div>
                <div class="edu-body edu-body-full">
                  <div class="lang-head">
                    <p class="edu-title">{lang.name}</p>
                    <p class="lang-level mono">{lang.level}</p>
                  </div>
                  <div class="progress-track">
                    <div class="progress-fill" style={`--pct:${lang.progress}%`} />
                  </div>
                  {lang.certificateUrl && (
                    <a class="cert-btn mono" href={lang.certificateUrl} download>
                      <span class="arrow">↓</span> {lang.certificateLabel}
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edu-section {
    padding-block: var(--space-section);
    border-top: 1px solid var(--line);
  }

  .section-heading {
    margin-top: 0.6rem;
  }

  .edu-columns {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .col-label {
    font-size: var(--fs-xs);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .card-list {
    margin-top: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-card {
    display: flex;
    gap: 1.1rem;
    padding: 1.4rem;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: transform 0.25s var(--ease-out), border-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }

  .edu-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-2);
    box-shadow: 0 20px 40px -28px rgba(94, 234, 212, 0.3);
  }

  .edu-icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: var(--bg-elevated-2);
    border: 1px solid var(--line);
    color: var(--accent-2);
  }

  .edu-icon svg {
    width: 24px;
    height: 24px;
  }

  .edu-body {
    min-width: 0;
  }

  .edu-body-full {
    flex: 1;
  }

  .edu-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
  }

  .edu-institution {
    margin-top: 0.4rem;
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }

  .edu-period {
    margin-top: 0.3rem;
    font-size: var(--fs-xs);
    color: var(--ink-faint);
  }

  .lang-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .lang-level {
    font-size: var(--fs-xs);
    color: var(--accent-2);
  }

  .progress-track {
    margin-top: 0.9rem;
    height: 6px;
    border-radius: 999px;
    background: var(--bg-elevated-2);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent-2), var(--accent));
    transition: width 1s var(--ease-out) 0.15s;
  }

  .reveal.is-visible .progress-fill {
    width: var(--pct);
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-fill {
      width: var(--pct);
    }
  }

  .cert-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1rem;
    font-size: var(--fs-2xs);
    color: var(--accent-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.85rem;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .cert-btn:hover {
    border-color: var(--accent-2);
    color: var(--ink);
  }

  .arrow {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .edu-columns {
      gap: 2.25rem;
    }

    .edu-card {
      padding: 1.1rem;
      gap: 0.85rem;
    }

    .edu-icon {
      width: 38px;
      height: 38px;
    }

    .edu-icon svg {
      width: 20px;
      height: 20px;
    }

    .edu-title {
      font-size: var(--fs-base);
    }
  }
</style>
