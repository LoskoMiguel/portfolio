---
import { Image } from "astro:assets";
import { getLang, getProfile, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { recognitions } = getProfile(lang);
---

<section id="reconocimientos" class="recognition-section">
  <div class="wrap">
    <p class="eyebrow reveal">{t("rec.eyebrow")}</p>
    <h2 class="section-heading reveal">{t("rec.heading")}</h2>

    <div class="recognition-list">
      {
        recognitions.map((item, i) => (
          <article class="recognition-card reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="recognition-body">
              <p class="recognition-period mono">{item.period}</p>
              <h3 class="recognition-title">{item.title}</h3>
              <p class="recognition-organizer mono">{item.organizer}</p>
              <p class="recognition-desc">{item.description}</p>

              {item.links && item.links.length > 0 && (
                <div class="recognition-links">
                  {item.links.map((link) => (
                    <a class="link-btn mono" href={link.url} target="_blank" rel="noopener noreferrer">
                      <span class="arrow">↗</span> {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>

            {item.photos && item.photos.length > 0 && (
              <div class="recognition-gallery">
                {item.photos.map((photo, pi) => (
                  <button
                    type="button"
                    class="gallery-frame"
                    data-lightbox-target={`lightbox-photo-${i}-${pi}`}
                    aria-label={t("rec.enlarge", { n: pi + 1, title: item.title })}
                  >
                    <Image src={photo} alt={t("rec.photoAlt", { title: item.title, n: pi + 1 })} width={520} class="gallery-photo" />
                  </button>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" type="button" aria-label={t("lightbox.closeImage")}>×</button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" type="button" aria-label={t("lightbox.prevImage")}>‹</button>
    <button class="lightbox-nav lightbox-next" id="lightbox-next" type="button" aria-label={t("lightbox.nextImage")}>›</button>
    {
      recognitions.map((item, i) =>
        item.photos?.map((photo, pi) => (
          <Image
            src={photo}
            alt={t("rec.photoAlt", { title: item.title, n: pi + 1 })}
            width={1200}
            class="lightbox-photo"
            id={`lightbox-photo-${i}-${pi}`}
          />
        ))
      )
    }
  </div>
</section>

<script>
  const lightbox = document.getElementById("lightbox");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-lightbox-target]");
  const photos = Array.from(document.querySelectorAll<HTMLImageElement>(".lightbox-photo"));

  let currentIndex = 0;

  if (photos.length > 1) {
    lightbox?.classList.add("has-multiple");
  }

  function showPhoto(index: number) {
    currentIndex = (index + photos.length) % photos.length;
    photos.forEach((photo, i) => photo.classList.toggle("is-active", i === currentIndex));
  }

  function openLightbox(id: string) {
    const index = photos.findIndex((photo) => photo.id === id);
    showPhoto(index === -1 ? 0 : index);
    lightbox?.classList.add("is-open");
    lightbox?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox?.classList.remove("is-open");
    lightbox?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const target = trigger.dataset.lightboxTarget;
      if (target) openLightbox(target);
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", () => showPhoto(currentIndex - 1));
  nextBtn?.addEventListener("click", () => showPhoto(currentIndex + 1));

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("is-open")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") showPhoto(currentIndex - 1);
    if (e.key === "ArrowRight") showPhoto(currentIndex + 1);
  });
</script>

<style>
  .recognition-section {
    padding-block: var(--space-section);
    border-top: 1px solid var(--line);
  }

  .section-heading {
    margin-top: 0.6rem;
  }

  .recognition-list {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .recognition-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 340px);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding: 1.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.25s var(--ease-out), transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }

  .recognition-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-2);
    box-shadow: 0 20px 40px -28px rgba(94, 234, 212, 0.3);
  }

  .recognition-period {
    font-size: var(--fs-xs);
    color: var(--accent);
  }

  .recognition-title {
    margin-top: 0.5rem;
    font-size: var(--fs-lg);
    max-width: 40ch;
  }

  .recognition-organizer {
    margin-top: 0.4rem;
    font-size: var(--fs-xs);
    color: var(--ink-faint);
  }

  .recognition-desc {
    margin-top: 1rem;
    color: var(--ink-muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
    max-width: 60ch;
  }

  .recognition-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.3rem;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--fs-2xs);
    color: var(--accent-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.85rem;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .link-btn:hover {
    border-color: var(--accent-2);
    color: var(--ink);
  }

  .arrow {
    color: var(--accent);
  }

  .recognition-gallery {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .gallery-frame {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--bg-elevated-2);
    aspect-ratio: 4 / 3;
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .gallery-frame:hover {
    border-color: var(--accent-2);
    transform: translateY(-2px);
  }

  .gallery-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 3rem);
    background: rgba(10, 14, 23, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s var(--ease-out), visibility 0.25s var(--ease-out);
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-photo {
    display: none;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7);
  }

  .lightbox-photo.is-active {
    display: block;
  }

  .lightbox-close {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--ink);
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .lightbox-close:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .lightbox-nav {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .lightbox.has-multiple .lightbox-nav {
    display: flex;
  }

  .lightbox-nav:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .lightbox-prev {
    left: clamp(0.5rem, 3vw, 2rem);
  }

  .lightbox-next {
    right: clamp(0.5rem, 3vw, 2rem);
  }

  @media (max-width: 560px) {
    .lightbox-nav {
      width: 38px;
      height: 38px;
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }

  @media (max-width: 800px) {
    .recognition-card {
      grid-template-columns: 1fr;
    }

    .recognition-gallery {
      flex-direction: row;
    }

    .gallery-frame {
      flex: 1;
    }
  }

  @media (max-width: 480px) {
    .recognition-card {
      padding: 1.2rem;
    }

    .recognition-gallery {
      flex-direction: column;
    }
  }
</style>
