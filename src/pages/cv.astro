---
// Hoja de vida imprimible. `npm run cv` la convierte en public/cv/*.pdf con Chrome headless.
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import { Image } from "astro:assets";
// Recorte cuadrado de miguel.webp (cabeza y hombros) con fondo claro para impresión
import photo from "../assets/miguel-cv.webp";
import { personal, experience, projects, recognitions, stack, education, languages } from "../data/profile";

const cvProjects = projects.filter((project) => project.summary);
const phoneHref = `tel:+57${personal.phone}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{personal.name} — Hoja de vida</title>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <Image src={photo} alt={personal.name} width={400} class="photo" />
        <div class="identity">
          <h1 class="name">{personal.name}</h1>
          <p class="role">
            {personal.role}
            <span class="role-english">Inglés B2 certificado</span>
          </p>
          <ul class="contact">
            <li><a href={`mailto:${personal.email}`}>{personal.email}</a></li>
            <li><a href={phoneHref}>{personal.phoneDisplay}</a></li>
            <li>{personal.location}</li>
            <li><a href={personal.github}>{personal.githubHandle}</a></li>
            <li><a href={personal.website}>{personal.websiteDisplay}</a></li>
          </ul>
        </div>
      </header>

      <p class="summary">{personal.summary}</p>

      <div class="columns">
        <div class="main">
          <section>
            <h2>Experiencia</h2>
            {
              experience.map((job) => (
                <article class="entry">
                  <div class="entry-head">
                    <h3>{job.role}</h3>
                    <p class="period">{job.period}</p>
                  </div>
                  <p class="org">{job.company}</p>
                  <ul class="bullets">
                    {job.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </section>

          <section>
            <h2>Proyectos</h2>
            {
              cvProjects.map((project) => (
                <article class="entry">
                  <div class="entry-head">
                    <h3>{project.name}</h3>
                    {project.repoUrl && (
                      <a class="period" href={project.repoUrl}>
                        {project.repoUrl.replace("https://", "")}
                      </a>
                    )}
                  </div>
                  <p class="entry-text">{project.summary}</p>
                  <p class="tech">{project.stack.join(", ")}</p>
                </article>
              ))
            }
          </section>

          <section>
            <h2>Reconocimientos</h2>
            {
              recognitions.map((item) => (
                <article class="entry entry-tight">
                  <div class="entry-head">
                    <h3>{item.title}</h3>
                    <p class="period">{item.period}</p>
                  </div>
                  <p class="org">
                    Proyecto {item.project}. {item.organizer}
                  </p>
                </article>
              ))
            }
          </section>
        </div>

        <aside class="side">
          <section>
            <h2>Tecnologías</h2>
            <dl class="skills">
              {
                stack.map((group) => (
                  <div>
                    <dt>{group.label}</dt>
                    <dd>{group.items.map((item) => item.name).join(", ")}</dd>
                  </div>
                ))
              }
            </dl>
          </section>

          <section>
            <h2>Formación</h2>
            {
              education.map((item) => (
                <article class="entry entry-tight">
                  <h3>{item.title}</h3>
                  <p class="org">{item.institution}</p>
                  <p class="period">{item.period}</p>
                </article>
              ))
            }
          </section>

          <section>
            <h2>Idiomas</h2>
            <ul class="langs">
              {
                languages.map((lang) => (
                  <li>
                    <strong>{lang.name}</strong> {lang.level}
                  </li>
                ))
              }
            </ul>
          </section>
        </aside>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --cv-ink: #141a26;
    --cv-muted: #4d5768;
    --cv-line: #d9dde5;
    --cv-accent: #b26b00;
    --cv-paper: #ffffff;
  }

  @page {
    size: letter;
    margin: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: #e9ebef;
    color-scheme: light;
  }

  body {
    margin: 0;
    color: var(--cv-ink);
    font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
    font-size: 9.4pt;
    line-height: 1.4;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  h1,
  h2,
  h3,
  p,
  ul,
  dl,
  dd {
    margin: 0;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Hoja carta: 8.5in × 11in */
  .page {
    width: 8.5in;
    min-height: 11in;
    margin: 24px auto;
    padding: 0.4in 0.55in 0.3in;
    background: var(--cv-paper);
    box-shadow: 0 10px 40px rgba(20, 26, 38, 0.12);
  }

  @media print {
    html {
      background: none;
    }

    .page {
      margin: 0;
      box-shadow: none;
    }
  }

  .header {
    display: flex;
    align-items: center;
    gap: 18pt;
    padding-bottom: 11pt;
    border-bottom: 2pt solid var(--cv-ink);
  }

  .photo {
    flex-shrink: 0;
    width: 1.35in;
    height: 1.35in;
    object-fit: cover;
    border-radius: 6pt;
  }

  .identity {
    flex: 1;
  }

  .name {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 23pt;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .role {
    margin-top: 4pt;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 12pt;
    color: var(--cv-accent);
  }

  .role-english {
    margin-left: 6pt;
    padding: 1pt 6pt;
    font-family: "IBM Plex Sans", sans-serif;
    font-weight: 600;
    font-size: 8.8pt;
    color: var(--cv-ink);
    border: 1pt solid var(--cv-ink);
    border-radius: 3pt;
    vertical-align: 1pt;
  }

  .contact {
    margin-top: 9pt;
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: start;
    gap: 2pt 16pt;
    font-size: 8.8pt;
    line-height: 1.45;
    color: var(--cv-muted);
  }

  .summary {
    margin-top: 9pt;
    font-size: 10pt;
    line-height: 1.5;
  }

  .columns {
    margin-top: 10pt;
    display: grid;
    grid-template-columns: 1fr 2.4in;
    gap: 0.28in;
  }

  section + section {
    margin-top: 10pt;
  }

  h2 {
    margin-bottom: 7pt;
    padding-bottom: 3pt;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 11pt;
    border-bottom: 1pt solid var(--cv-line);
  }

  h3 {
    font-weight: 600;
    font-size: 9.8pt;
    line-height: 1.3;
  }

  .entry + .entry {
    margin-top: 8pt;
  }

  .entry-tight + .entry-tight {
    margin-top: 6pt;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .period {
    flex-shrink: 0;
    font-size: 8.6pt;
    color: var(--cv-muted);
  }

  .org {
    color: var(--cv-muted);
  }

  .entry-text {
    margin-top: 1pt;
  }

  .tech {
    margin-top: 2pt;
    font-size: 8.6pt;
    color: var(--cv-accent);
  }

  .bullets {
    margin-top: 3pt;
  }

  .bullets li {
    position: relative;
    padding-left: 10pt;
  }

  .bullets li + li {
    margin-top: 1pt;
  }

  .bullets li::before {
    content: "";
    position: absolute;
    left: 1pt;
    top: 0.62em;
    width: 3.5pt;
    height: 3.5pt;
    border-radius: 50%;
    background: var(--cv-accent);
  }

  .skills div + div {
    margin-top: 4pt;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    color: var(--cv-muted);
  }

  .langs li {
    color: var(--cv-muted);
  }

  .langs li + li {
    margin-top: 3pt;
  }

  .langs strong {
    margin-right: 4pt;
    font-weight: 600;
    color: var(--cv-ink);
  }

  .side .entry-tight + .entry-tight {
    margin-top: 7pt;
  }
</style>
